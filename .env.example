# Copy to .env. Keep comments on their own lines (systemd reads this file too).
# Machine key for `autoapply finish` on your laptop (not a sign-in password: the dashboard has its own account).
# Leave it blank and one is made in data/secrets.json when you create your account.
AUTOAPPLY_TOKEN=
# Where the review page is reachable from your other devices (used in links and by autoapply-finish).
REVIEW_URL=http://<server-ip>:8787/
# Optional phone push via the ntfy app: pick an unguessable topic name.
NTFY_TOPIC=
# Read-only IMAP for alerts and replies, SMTP for the morning brief. Google account > Security > App passwords.
GMAIL_USER=you@gmail.com
GMAIL_APP_PASSWORD=
# Optional: send the morning brief somewhere other than GMAIL_USER.
BRIEF_TO=
# Only if email_classifier uses OpenRouter.
OPENROUTER_API_KEY=
# Optional job sources with free keys (or enter them on the Setup page).
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
USAJOBS_API_KEY=
USAJOBS_EMAIL=
# Docker only (docker compose reads this file too).
# BIND=100.x.y.z        dashboard address on the host (default 127.0.0.1)
# APP_UID=1000          your user id (id -u) so files in the folder stay yours
# APP_GID=1000
# DAILY_AT=06:30
# DAILY_DAYS=1-5
# TZ=America/New_York
